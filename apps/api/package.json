{
  "name": "@tenantly/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate --config=drizzle.config.js",
    "db:migrate": "drizzle-kit migrate --config=drizzle.config.js",
    "db:seed": "tsx src/db/seed.ts",
    "lint": "eslint . --max-warnings=0",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "2.1.6",
    "@tenantly/contracts": "workspace:*",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "hono": "4.13.16",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@tenantly/eslint-config": "workspace:*",
    "@tenantly/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "catalog:",
    "tsx": "4.23.15",
    "typescript": "catalog:"
  }
}
